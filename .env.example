# Copy to .env.local and fill in. Never commit real keys.
# None of these are required: without them PAI uses its local engine.

# Server-only. Enables the Claude path for PAI. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Required alongside the key. No default on purpose, so nothing expensive runs by accident.
# A fast, inexpensive model is the right fit, e.g. claude-haiku-4-5.
ANTHROPIC_MODEL=

# LLM requests per minute per IP, per runtime instance. Over the limit, PAI answers locally.
ASSISTANT_LLM_REQUESTS_PER_MINUTE=8

# Public base URL, used for OpenGraph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
